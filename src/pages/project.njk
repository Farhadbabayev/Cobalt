              <li class="footer-list-item">153 Neftchilar Avenue, Port Baku Towers<br>AZ1010 Baku, Azerbaijan</li>
            </ul>
          </div>
        </div>
        <div class="footer-1-3-block">
          <div class="div-block-44">
            <a id="Contacts-Button" href="/get-in-touch" class="button-2 w-button">Get in Touch</a>
          </div>
        </div>
        <div class="footer-1-3-block">
          <div class="div-block-43 w-clearfix">
            <a href="#" class="link-block-3 w-inline-block"><img src="/images/Vector-550.png" loading="lazy" data-w-id="ddb36957-5d68-dd5f-2cff-3ba8d181816d" alt="" class="image-29"></a>
          </div>
        </div>
      </div>
    </div>
    <div class="footer-lower-div">
      <div class="footer-3-3-parent-block bottom-line">
        <div class="footer-1-3-block bottom">
          <a href="#" class="footer-privacy-policy-link-block w-inline-block">
            <div class="footer-bottom-text-block">Privacy Policy</div>
          </a>
        </div>
        <div class="footer-1-3-block bottom last">
          <div class="footer-bottom-text-block"><strong class="bold-text">© {{ year }} Cobalt. All Rights Reserved.</strong><br></div>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/jquery-3.5.1.min.js" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="/js/webflow.js" type="text/javascript"></script>

  </div>
  {% macro grid(images, wid, cls) %}{% if images.length %}
      <div>
        <div class="pp-collection-list-wrapper w-dyn-list">
          <div role="list" class="pp-collection-list w-dyn-items">
            {% for src in images %}<div role="listitem" class="w-dyn-item"><img alt="{{ project.name }}" loading="lazy" data-w-id="{{ wid }}" src="{{ src }}"{% if cls %} class="{{ cls }}"{% endif %}></div>
            {% endfor %}
          </div>
        </div>
      </div>{% endif %}{% endmacro %}
  {% macro horizontal(images) %}{% if images.length %}
      <div>
        <div data-w-id="a27e3fac-799c-2f50-6324-dd63d6451e99" class="pp-collection-list-wrapper w-dyn-list">
          <div role="list" class="pp-collection-list-horizontal w-dyn-items">
            {% for src in images %}<div role="listitem" class="w-dyn-item"><img data-w-id="214f9e15-3e7e-fc1a-c40a-2d19945b7b24" loading="lazy" style="opacity:0" src="{{ src }}" alt="{{ project.name }}" class="image-38"></div>
            {% endfor %}
          </div>
        </div>
      </div>{% endif %}{% endmacro %}
  {% macro topImages(images, wid) %}{% if images.length %}
      <div class="div-block-57">
        <div class="w-dyn-list">
          <div data-w-id="{{ wid }}" role="list" class="collection-list-10 w-dyn-items">
            {% for src in images %}<div role="listitem" class="w-dyn-item"><img src="{{ src }}" loading="lazy" alt="{{ project.name }}" class="image-34"></div>
            {% endfor %}
          </div>
        </div>
      </div>{% endif %}{% endmacro %}
  {% macro paragraph(text, cls) %}{% if text %}
      <div class="pp-architecture-description-wrapper">
        <p class="{{ cls }}">{{ text | nl2br }}</p>
      </div>{% endif %}{% endmacro %}
  {% set a = project.architecture %}{% set i = project.interior %}
  <div class="general-wrapper">
    <div class="header-section-projects">
      <div class="div-block-56">{% if project.headerImage %}<img loading="lazy" alt="{{ project.name }}" src="{{ project.headerImage }}" class="image-40">{% endif %}</div>
    </div>
    <div data-w-id="dbdc334d-adfe-cf94-663a-a5f436b082cc" style="opacity:0" class="projects-page-section">
      <div class="project-text-block-wrapper">
        <div id="w-node-_45a8ee34-e847-19fb-68ee-f98220bf9a7d-150a2ae1">
          <h2 class="heading-28">About</h2>
          <p class="paragraph-8">{{ project.about | nl2br }}</p>
        </div>
      </div>{% if project.featureVideo %}<video src="{{ project.featureVideo }}" class="image-31 fade-in" autoplay muted loop playsinline></video>{% elif project.featureImage %}<img src="{{ project.featureImage }}" loading="lazy" alt="{{ project.name }}" class="image-31 fade-in">{% endif %}
      <div class="project-text-block-wrapper">
        <div id="w-node-_03388bb3-d03e-2348-fa0c-f252126c9599-150a2ae1" class="project-text-block-1-3">
          <ul role="list" class="list-3 w-list-unstyled">
            {% for label, value in [["Project Name", project.displayName or project.name], ["Project Type", project.projectType], ["Authors", project.authors], ["Status", project.status], ["Year", project.year]] %}{% if value %}
            <li class="project-credentials-list-item">
              <div class="project-credentials-item-name">{{ label }}: </div>
              <div class="project-credentials-item-value">{{ value }}</div>
            </li>{% endif %}{% endfor %}
          </ul>
        </div>
        {% if project.team %}<div id="w-node-_03388bb3-d03e-2348-fa0c-f252126c95af-150a2ae1" class="div-block-61">
          <div id="w-node-_03388bb3-d03e-2348-fa0c-f252126c95b0-150a2ae1" class="text-block-22">TEAM </div>
          <p class="paragraph-7">{{ project.team | nl2br }}</p>
        </div>{% endif %}
      </div>
    </div>
  </div>
  <div class="architecture-wrapper">
    <div class="projects-page-section">
      {{ topImages(a.topImages, "96774241-77dd-3dfc-a921-e527baeeb042") }}
      {% if a.image %}<div class="description-below-picture"><img data-w-id="1fdb7f69-5dbf-d67f-0069-db53f3da3d8b" loading="lazy" style="opacity:0" src="{{ a.image }}" alt="{{ project.name }}" class="pp-image"></div>{% endif %}
      {{ paragraph(a.description, "pp-architecture-description") }}
      {{ grid(a.images, "475a668f-33e2-568a-f04b-b59669c68082") }}
    </div>
  </div>
  <div class="interior-wrapper">
    <div class="projects-page-section">
      {{ topImages(i.topImages, "cfafff89-eddb-a554-88c4-1a00a4640e4f") }}
      {% if i.image %}<img alt="{{ project.name }}" loading="lazy" data-w-id="cfafff89-eddb-a554-88c4-1a00a4640e56" src="{{ i.image }}" class="pp-image">{% endif %}
      {{ paragraph(i.description, "paragraph-10") }}
      {{ grid(i.images, "6d2f9f27-c537-deb5-7765-a5633e4c117a", "image-33") }}
      {{ horizontal(i.horizontalImages) }}
      {{ grid(i.images2, "91cf890b-bcab-9d4d-3650-77dd07212de2") }}
      {{ horizontal(i.horizontalImages2) }}
      {{ grid(i.images3, "91cf890b-bcab-9d4d-3650-77dd07212de2") }}
    </div>
  </div>
  <div class="projects-page-bottom-wrapper">
    <div class="projects-page-section bottom"></div>
  </div>
  <div class="footer-section">
    <div class="footer-social-links-div w-clearfix">
      <a href="https://www.instagram.com/cobalt.az/" class="footer-social-link left w-inline-block w-clearfix">
        <div class="social-link-text left">INST</div>
      </a>
      <a href="https://www.linkedin.com/company/cobaltazerbaijan" class="footer-social-link mid w-inline-block">
